cmake_minimum_required(VERSION 3.16)

if(NOT DEFINED ANO_CRYPTO_SOURCE_DIR)
    get_filename_component(ANO_CRYPTO_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED ANO_CRYPTO_RANDOM_LIFECYCLE_CHECK_OUTPUT)
    set(ANO_CRYPTO_RANDOM_LIFECYCLE_CHECK_OUTPUT "${ANO_CRYPTO_SOURCE_DIR}/build/policy-check/RANDOM_LIFECYCLE_HARDENING_CHECK.txt")
endif()

get_filename_component(_out_dir "${ANO_CRYPTO_RANDOM_LIFECYCLE_CHECK_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")
set(_failures "")

function(require_file rel)
    if(NOT EXISTS "${ANO_CRYPTO_SOURCE_DIR}/${rel}")
        list(APPEND _failures "missing file: ${rel}")
        set(_failures "${_failures}" PARENT_SCOPE)
    endif()
endfunction()

function(require_token rel token)
    if(NOT EXISTS "${ANO_CRYPTO_SOURCE_DIR}/${rel}")
        list(APPEND _failures "missing file for token check: ${rel}")
        set(_failures "${_failures}" PARENT_SCOPE)
        return()
    endif()
    file(READ "${ANO_CRYPTO_SOURCE_DIR}/${rel}" _content)
    string(FIND "${_content}" "${token}" _index)
    if(_index EQUAL -1)
        list(APPEND _failures "missing token '${token}' in ${rel}")
        set(_failures "${_failures}" PARENT_SCOPE)
    endif()
endfunction()

foreach(_file
    abi/ANOCRYPTO_C_0_EXPORTED_SYMBOLS.txt
    tests/stress/random_lifecycle_stress_tests.c
    tests/operational/random_platform_review.c
    tests/negative/random_reseed_limit_tests.c
    docs/design/C99_RANDOM_OPERATIONAL_PORTABILITY_POLICY.md
    docs/ci/RANDOM_LIFECYCLE_HARDENING_CI_CHECKLIST.md
    tools/check_exported_symbols.cmake
    tools/check_clean_release_symbols.cmake)
    require_file("${_file}")
endforeach()

require_token(CMakeLists.txt "ANO_CRYPTO_ENABLE_RANDOM_TEST_HOOKS")
require_token(CMakeLists.txt "ano_crypto_random_lifecycle_stress_tests")
require_token(CMakeLists.txt "ano_crypto_clean_release_symbol_baseline_check")
require_token(src/drbg/process_guard.c "ANO_CRYPTO_ERR_NOT_IMPLEMENTED")
require_token(src/drbg/random.c "ano_crypto_internal_process_guard_is_supported")
require_token(src/drbg/drbg.c "ANO_CRYPTO_INTERNAL_HMAC_DRBG_RESEED_INTERVAL")
require_token(include/anocrypto/ac_random.h "VM snapshot/restore, clone")
require_token(docs/design/C99_RANDOM_OPERATIONAL_PORTABILITY_POLICY.md "discard and reinitialize")
require_token(docs/design/C99_RANDOM_OPERATIONAL_PORTABILITY_POLICY.md "process marker")
require_token(docs/ci/RANDOM_LIFECYCLE_HARDENING_CI_CHECKLIST.md "generated bytes")

file(STRINGS "${ANO_CRYPTO_SOURCE_DIR}/abi/ANOCRYPTO_C_0_EXPORTED_SYMBOLS.txt" _symbols)
list(LENGTH _symbols _symbol_count)
if(NOT _symbol_count EQUAL 69)
    list(APPEND _failures "ABI-0 symbol baseline count is ${_symbol_count}; expected 69")
endif()

file(GLOB_RECURSE _public_headers LIST_DIRECTORIES false "${ANO_CRYPTO_SOURCE_DIR}/include/anocrypto/*.h")
foreach(_header IN LISTS _public_headers)
    file(READ "${_header}" _header_content)
    if(_header_content MATCHES "test_set_reseed_counter|ENABLE_RANDOM_TEST_HOOKS|ANO_CRYPTO_INTERNAL_HMAC_DRBG_RESEED_INTERVAL")
        list(APPEND _failures "public header exposes random test-hook token: ${_header}")
    endif()
endforeach()

file(WRITE "${ANO_CRYPTO_RANDOM_LIFECYCLE_CHECK_OUTPUT}"
    "AnoCrypto-C P1-20 random lifecycle hardening policy check\n"
    "ABI-0 baseline symbols: ${_symbol_count}\n")
if(_failures)
    foreach(_failure IN LISTS _failures)
        file(APPEND "${ANO_CRYPTO_RANDOM_LIFECYCLE_CHECK_OUTPUT}" "FAIL: ${_failure}\n")
    endforeach()
    message(FATAL_ERROR "Random lifecycle hardening policy check failed; see ${ANO_CRYPTO_RANDOM_LIFECYCLE_CHECK_OUTPUT}")
endif()
file(APPEND "${ANO_CRYPTO_RANDOM_LIFECYCLE_CHECK_OUTPUT}" "Result: PASS\n")
message(STATUS "AnoCrypto-C random lifecycle hardening policy check passed")
