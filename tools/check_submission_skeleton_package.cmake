cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED ANO_CRYPTO_SUBMISSION_SKELETON_DIR)
  message(FATAL_ERROR "ANO_CRYPTO_SUBMISSION_SKELETON_DIR is required")
endif()
get_filename_component(_root "${ANO_CRYPTO_SUBMISSION_SKELETON_DIR}" ABSOLUTE)
set(_manifest "${_root}/SUBMISSION_SKELETON_MANIFEST.sha256")
set(_status "${_root}/PACKAGE_STATUS.txt")
if(NOT EXISTS "${_manifest}" OR NOT EXISTS "${_status}")
  message(FATAL_ERROR "submission skeleton manifest/status missing")
endif()
file(READ "${_status}" _status_text)
foreach(_marker IN ITEMS
  "policy_id=SDP-P2-07-R1"
  "policy_status=CONTROLLED_INTERNAL_SKELETON_COMPLETE"
  "formal_template_conformity=EXTERNAL_CONFIRMATION_REQUIRED"
  "institution_results=NOT_RUN"
  "external_authorization=NO"
  "contains_source_or_binary=NO"
  "contains_sensitive_material=NO")
  string(FIND "${_status_text}" "${_marker}" _pos)
  if(_pos EQUAL -1)
    message(FATAL_ERROR "package status missing ${_marker}")
  endif()
endforeach()
file(STRINGS "${_manifest}" _lines)
set(_count 0)
foreach(_line IN LISTS _lines)
  string(LENGTH "${_line}" _line_len)
  if(_line_len LESS 67)
    message(FATAL_ERROR "malformed manifest line: ${_line}")
  endif()
  string(SUBSTRING "${_line}" 0 64 _expected)
  string(SUBSTRING "${_line}" 64 2 _separator)
  math(EXPR _path_len "${_line_len}-66")
  string(SUBSTRING "${_line}" 66 ${_path_len} _rel)
  if(NOT _expected MATCHES "^[0-9a-f]+$" OR NOT _separator STREQUAL "  " OR _rel STREQUAL "")
    message(FATAL_ERROR "malformed manifest line: ${_line}")
  endif()
  if(_rel MATCHES "(^|/)[.][.]($|/)" OR _rel MATCHES "[.](c|h|o|a|so|dll|dylib|exe)$")
    message(FATAL_ERROR "unsafe artifact in manifest: ${_rel}")
  endif()
  if(NOT EXISTS "${_root}/${_rel}" OR IS_DIRECTORY "${_root}/${_rel}" OR IS_SYMLINK "${_root}/${_rel}")
    message(FATAL_ERROR "manifest file missing/invalid: ${_rel}")
  endif()
  file(SHA256 "${_root}/${_rel}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "manifest hash mismatch: ${_rel}")
  endif()
  math(EXPR _count "${_count}+1")
endforeach()
if(NOT _count EQUAL 11)
  message(FATAL_ERROR "manifest count drifted: ${_count}")
endif()
file(GLOB_RECURSE _all LIST_DIRECTORIES false "${_root}/*")
list(LENGTH _all _all_count)
if(NOT _all_count EQUAL 13)
  message(FATAL_ERROR "unexpected package file count: ${_all_count}")
endif()
message(STATUS "P2-07 submission skeleton package check passed")
