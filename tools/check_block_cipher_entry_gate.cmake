cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED ANO_CRYPTO_SOURCE_DIR)
  get_filename_component(ANO_CRYPTO_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED ANO_CRYPTO_BUILD_DIR)
  set(ANO_CRYPTO_BUILD_DIR "${ANO_CRYPTO_SOURCE_DIR}/build")
endif()
if(NOT DEFINED ANO_CRYPTO_BLOCK_CIPHER_GATE_OUTPUT)
  set(ANO_CRYPTO_BLOCK_CIPHER_GATE_OUTPUT "${ANO_CRYPTO_BUILD_DIR}/policy-check/BLOCK_CIPHER_ENTRY_GATE_CHECK.txt")
endif()
get_filename_component(_out_dir "${ANO_CRYPTO_BLOCK_CIPHER_GATE_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")
set(_violations "")
function(require_file p)
  if(NOT EXISTS "${ANO_CRYPTO_SOURCE_DIR}/${p}")
    list(APPEND _violations "missing ${p}")
    set(_violations "${_violations}" PARENT_SCOPE)
  endif()
endfunction()
function(require_text p n)
  if(NOT EXISTS "${ANO_CRYPTO_SOURCE_DIR}/${p}")
    list(APPEND _violations "missing ${p}")
  else()
    file(READ "${ANO_CRYPTO_SOURCE_DIR}/${p}" _c)
    string(FIND "${_c}" "${n}" _i)
    if(_i EQUAL -1)
      list(APPEND _violations "${p} missing marker: ${n}")
    endif()
  endif()
  set(_violations "${_violations}" PARENT_SCOPE)
endfunction()
require_file("docs/design/BLOCK_CIPHER_MODE_SELECTION.md")
require_file("docs/design/C99_BLOCK_CIPHER_API_GATE.md")
require_file("docs/kcmvp/BLOCK_CIPHER_KAT_AND_EVIDENCE_PLAN.md")
require_file("evidence/release-template/BLOCK_CIPHER_ENTRY_GATE_REVIEW.md")
require_text("docs/design/BLOCK_CIPHER_MODE_SELECTION.md" "AES-128/192/256 encrypt and decrypt known-answer tests")
require_text("docs/design/BLOCK_CIPHER_MODE_SELECTION.md" "P1-24 intentionally does not add the header")
require_text("docs/kcmvp/BLOCK_CIPHER_KAT_AND_EVIDENCE_PLAN.md" "FIPS 197")
require_text("docs/kcmvp/BLOCK_CIPHER_KAT_AND_EVIDENCE_PLAN.md" "NIST SP 800-38A")
if(EXISTS "${ANO_CRYPTO_SOURCE_DIR}/include/anocrypto/ac_cipher.h")
  list(APPEND _violations "P1-24 must not add unreviewed public ac_cipher.h")
endif()
file(GLOB_RECURSE _sources "${ANO_CRYPTO_SOURCE_DIR}/src/cipher/*")
if(_sources)
  list(APPEND _violations "P1-24 entry gate must not add cipher implementation files")
endif()
file(WRITE "${ANO_CRYPTO_BLOCK_CIPHER_GATE_OUTPUT}" "AnoCrypto-C P1-24 block-cipher entry gate check\n")
if(_violations)
  file(APPEND "${ANO_CRYPTO_BLOCK_CIPHER_GATE_OUTPUT}" "Result: FAIL\n")
  foreach(v IN LISTS _violations)
    file(APPEND "${ANO_CRYPTO_BLOCK_CIPHER_GATE_OUTPUT}" "- ${v}\n")
  endforeach()
  message(FATAL_ERROR "Block-cipher entry gate check failed")
endif()
file(APPEND "${ANO_CRYPTO_BLOCK_CIPHER_GATE_OUTPUT}" "Result: PASS\nSelected next slice: AES primitive plus CBC without padding\nPublic ABI change: none\n")
message(STATUS "AnoCrypto-C block-cipher entry gate check passed")
