cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED ANO_CRYPTO_DRI_DIR OR ANO_CRYPTO_DRI_DIR STREQUAL "")
  message(FATAL_ERROR "ANO_CRYPTO_DRI_DIR is required")
endif()
get_filename_component(_dir "${ANO_CRYPTO_DRI_DIR}" ABSOLUTE)
if(NOT EXISTS "${_dir}/PACKAGE_STATUS.txt" OR NOT EXISTS "${_dir}/DOWNSTREAM_REQUIREMENT_INTAKE_MANIFEST.sha256")
  message(FATAL_ERROR "downstream requirement intake package control files missing")
endif()
file(READ "${_dir}/PACKAGE_STATUS.txt" _status)
foreach(_needle IN ITEMS
  "policy_id=DRI-P3-00-R1"
  "package_class=STATUS_ONLY_DOWNSTREAM_REQUIREMENT_INTAKE"
  "imported_source_sets=0"
  "accepted_requirements=0"
  "approved_gaps=0"
  "selected_implementation=NONE"
  "public_api_change_authorization=NO"
  "new_abi_line_authorization=NO"
  "contains_source_or_binary=NO"
  "contains_sensitive_material=NO")
  string(FIND "${_status}" "${_needle}" _pos)
  if(_pos EQUAL -1)
    message(FATAL_ERROR "downstream requirement intake package missing status: ${_needle}")
  endif()
endforeach()
file(STRINGS "${_dir}/DOWNSTREAM_REQUIREMENT_INTAKE_MANIFEST.sha256" _lines)
set(_count 0)
foreach(_line IN LISTS _lines)
  string(LENGTH "${_line}" _len)
  if(_len LESS 67)
    message(FATAL_ERROR "malformed downstream requirement intake manifest line: ${_line}")
  endif()
  string(SUBSTRING "${_line}" 0 64 _expected)
  string(SUBSTRING "${_line}" 64 2 _separator)
  math(EXPR _path_len "${_len}-66")
  string(SUBSTRING "${_line}" 66 ${_path_len} _rel)
  if(NOT _expected MATCHES "^[0-9a-f]+$" OR NOT _separator STREQUAL "  " OR _rel STREQUAL "")
    message(FATAL_ERROR "malformed downstream requirement intake manifest line: ${_line}")
  endif()
  if(NOT EXISTS "${_dir}/${_rel}" OR IS_DIRECTORY "${_dir}/${_rel}" OR IS_SYMLINK "${_dir}/${_rel}")
    message(FATAL_ERROR "manifest file missing: ${_rel}")
  endif()
  file(SHA256 "${_dir}/${_rel}" _actual)
  if(NOT _actual STREQUAL _expected)
    message(FATAL_ERROR "manifest hash mismatch: ${_rel}")
  endif()
  math(EXPR _count "${_count}+1")
endforeach()
if(NOT _count EQUAL 15)
  message(FATAL_ERROR "downstream requirement intake package document count drifted: ${_count}")
endif()
file(GLOB_RECURSE _all RELATIVE "${_dir}" "${_dir}/*")
set(_files 0)
foreach(_rel IN LISTS _all)
  if(IS_DIRECTORY "${_dir}/${_rel}")
    continue()
  endif()
  math(EXPR _files "${_files}+1")
  if(_rel MATCHES "[.](c|h|o|a|so|dll|dylib|exe|key|pem|p12|pfx|sig|tsr)$")
    message(FATAL_ERROR "forbidden file in downstream requirement intake package: ${_rel}")
  endif()
endforeach()
if(NOT _files EQUAL 17)
  message(FATAL_ERROR "downstream requirement intake package total file count drifted: ${_files}")
endif()
message(STATUS "P3-00 downstream requirement intake package check passed")
