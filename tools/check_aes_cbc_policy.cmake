cmake_minimum_required(VERSION 3.16)
if(NOT DEFINED ANO_CRYPTO_SOURCE_DIR)
  get_filename_component(ANO_CRYPTO_SOURCE_DIR "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
endif()
if(NOT DEFINED ANO_CRYPTO_BUILD_DIR)
  set(ANO_CRYPTO_BUILD_DIR "${ANO_CRYPTO_SOURCE_DIR}/build")
endif()
if(NOT DEFINED ANO_CRYPTO_AES_CBC_CHECK_OUTPUT)
  set(ANO_CRYPTO_AES_CBC_CHECK_OUTPUT "${ANO_CRYPTO_BUILD_DIR}/policy-check/AES_CBC_IMPLEMENTATION_CHECK.txt")
endif()
get_filename_component(_out_dir "${ANO_CRYPTO_AES_CBC_CHECK_OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")
set(_violations "")
function(require_file p)
  if(NOT EXISTS "${ANO_CRYPTO_SOURCE_DIR}/${p}")
    list(APPEND _violations "missing ${p}")
    set(_violations "${_violations}" PARENT_SCOPE)
  endif()
endfunction()
function(require_text p n)
  if(NOT EXISTS "${ANO_CRYPTO_SOURCE_DIR}/${p}")
    list(APPEND _violations "missing ${p}")
  else()
    file(READ "${ANO_CRYPTO_SOURCE_DIR}/${p}" _c)
    string(FIND "${_c}" "${n}" _i)
    if(_i EQUAL -1)
      list(APPEND _violations "${p} missing marker: ${n}")
    endif()
  endif()
  set(_violations "${_violations}" PARENT_SCOPE)
endfunction()
foreach(_p IN ITEMS
  include/anocrypto/ac_cipher.h
  src/cipher/aes.c
  src/cipher/cipher.c
  src/internal/ac_aes_internal.h
  tests/kat/aes_cbc_kat_tests.c
  tests/negative/cipher_api_negative_tests.c
  tests/differential/aes_cbc_openssl_differential_tests.c
  docs/design/C99_BLOCK_CIPHER_API_GATE.md
  docs/design/AES_CBC_IMPLEMENTATION_POLICY.md
  docs/kcmvp/BLOCK_CIPHER_KAT_AND_EVIDENCE_PLAN.md
  evidence/release-template/AES_CBC_IMPLEMENTATION_REVIEW.md
  abi/ANOCRYPTO_C_0_EXPORTED_SYMBOLS.txt)
  require_file("${_p}")
endforeach()
require_text("include/anocrypto/ac_cipher.h" "CBC without padding")
require_text("include/anocrypto/ac_cipher.h" "Partial overlap is rejected")
require_text("src/cipher/aes.c" "ano_crypto_aes_gf_inverse")
require_text("src/cipher/cipher.c" "ANO_CRYPTO_KEY_TYPE_BLOCK_CIPHER")
require_text("tests/kat/aes_cbc_kat_tests.c" "AES-128/192/256 primitive and CBC KATs passed")
require_text("docs/design/AES_CBC_IMPLEMENTATION_POLICY.md" "table-free")
require_text("abi/ANOCRYPTO_C_0_EXPORTED_SYMBOLS.txt" "ano_crypto_cipher_crypt_with_key")
file(READ "${ANO_CRYPTO_SOURCE_DIR}/src/cipher/aes.c" _aes_source)
if(_aes_source MATCHES "sbox_table|SBOX_TABLE|\\[[ ]*256[ ]*\\]")
  list(APPEND _violations "AES implementation contains a table-shaped S-box artifact; P1-25 selected a table-free arithmetic path")
endif()
file(READ "${ANO_CRYPTO_SOURCE_DIR}/include/anocrypto/ac_cipher.h" _public_header)
if(_public_header MATCHES "openssl/|EVP_|OpenSSL::Crypto")
  list(APPEND _violations "public cipher header exposes test-only OpenSSL details")
endif()
file(WRITE "${ANO_CRYPTO_AES_CBC_CHECK_OUTPUT}" "AnoCrypto-C P1-25 AES/CBC implementation policy check\n")
if(_violations)
  file(APPEND "${ANO_CRYPTO_AES_CBC_CHECK_OUTPUT}" "Result: FAIL\n")
  foreach(v IN LISTS _violations)
    file(APPEND "${ANO_CRYPTO_AES_CBC_CHECK_OUTPUT}" "- ${v}\n")
  endforeach()
  message(FATAL_ERROR "AES/CBC implementation policy check failed")
endif()
file(APPEND "${ANO_CRYPTO_AES_CBC_CHECK_OUTPUT}" "Result: PASS\nImplemented: AES-128/192/256 primitive and CBC without padding\nPublic export baseline: 61 symbols\nSensitive values in policy output: none\n")
message(STATUS "AnoCrypto-C AES/CBC implementation policy check passed")
