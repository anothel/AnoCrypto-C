cmake_minimum_required(VERSION 3.16)
function(run)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    message("Command: ${ARGN}\nNative result: ${result}\n${out}${err}")
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Reproduction setup failed")
    endif()
endfunction()
set(src "${ANO_CRYPTO_SOURCE_DIR}")
set(build "${src}/build")
run("${CMAKE_COMMAND}" -S "${src}" -B "${build}" -DCMAKE_BUILD_TYPE=Debug
    -DANO_CRYPTO_BUILD_TESTS=ON -DANO_CRYPTO_BUILD_EXAMPLES=ON
    -DANO_CRYPTO_ENABLE_STRICT_WARNINGS=ON -DANO_CRYPTO_ENABLE_THREAD_SAFETY=ON
    -DANO_CRYPTO_ENABLE_OS_ENTROPY_PROVIDER=ON
    -DANO_CRYPTO_ENABLE_ENTROPY_TEST_HOOKS=OFF -DANO_CRYPTO_ENABLE_RANDOM_TEST_HOOKS=OFF
    -DANO_CRYPTO_ENABLE_OPENSSL_DIFFERENTIAL_TESTS=OFF)
run("${CMAKE_COMMAND}" --build "${build}" --config Debug --parallel)
if(WIN32)
    set(prefix "${src}/install-prefix")
    set(consumer "${src}/build-install-smoke")
    run("${CMAKE_COMMAND}" --install "${build}" --config Debug --prefix "${prefix}")
    run("${CMAKE_COMMAND}" -S "${src}/tests/install_smoke" -B "${consumer}" "-DCMAKE_PREFIX_PATH=${prefix}")
    run("${CMAKE_COMMAND}" --build "${consumer}" --config Debug --parallel)
    set(exe "${consumer}/Debug/anocrypto_c_install_smoke.exe")
    execute_process(COMMAND "${exe}" RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    message("Original workflow native result: ${result}\n${out}${err}")
    set(ENV{PATH} "${prefix}/bin;$ENV{PATH}")
    run("${exe}")
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" --build "${build}" --config Debug
        --target ano_crypto_poc_package_smoke RESULT_VARIABLE result OUTPUT_VARIABLE out ERROR_VARIABLE err)
    message("Original PoC native result: ${result}\n${out}${err}")
    file(GLOB_RECURSE logs "${build}/poc-package-smoke/*.log" "${build}/poc-package-smoke/*/policy-check/*.txt")
    foreach(log IN LISTS logs)
        file(READ "${log}" content)
        message("Log: ${log}\n${content}")
    endforeach()
    if(NOT "${result}" STREQUAL "0")
        message(FATAL_ERROR "Original PoC reproduction failed; nested logs printed above")
    endif()
endif()
